# NORAH — local environment variables
#
# Copy this file to .env and fill in the needed values there:
#   cp .env.example .env
#
# .env is already listed in .gitignore and must never be committed.

# Server-side AI provider key (keep secret).
GEMINI_API_KEY=

# Public app identity and OAuth portal origin. VITE_* values are embedded in
# the client bundle; use the same app ID configured for NORAH Core.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
