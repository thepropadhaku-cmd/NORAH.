# NORAH — local environment variables
#
# Copy this file to .env and fill in real values there:
#   cp .env.example .env
#
# .env is already listed in .gitignore (see the "Environment variables"
# section) and must never be committed. This file holds no secrets —
# it's just the variable name, safe to keep in the repo as a template.

GEMINI_API_KEY=
